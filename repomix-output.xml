            <line 
              x1="0" y1="1" x2="100%" y2="1" 
              stroke="var(--accent)" strokeWidth="2" 
              style={{
                strokeDasharray: 1000,
                strokeDashoffset: isVisible ? 0 : 1000,
                transition: 'stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1)'

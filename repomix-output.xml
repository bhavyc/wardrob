          white-space: nowrap; overflow: hidden;
          display: ${sidebarCollapsed ? 'none' : 'block'};
        }

        .hub-nav-link {
          display: flex; align-items: center;
          gap: 12px; text-decoration: none;
          padding: ${sidebarCollapsed ? '10px 0' : '11px 12px'};

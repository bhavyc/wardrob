      },
    },
  });
  console.log('Damage Report & Open Dispute created:', report1.id);

  console.log(' P2P Seeding process complete!');
}

main()
  .catch((e) => {
    console.error('Seeding failed:', e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
    await pool.end();
  });
</file>


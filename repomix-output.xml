                </div>

                {/* ── STEP 1: Personal Info ── */}
                {step === 1 && (
                  <div className="reg-box" key="step1">
                    <div className="reg-section-head">
                      <div className="reg-section-icon">👤</div>
                      <div>
                        <h1 className="reg-section-title">Your Information</h1>

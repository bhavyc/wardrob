          placeholder="Filter by Dress Title, SKU, Rack Location, or Renter Name..."
          value={searchQuery}
          onChange={e => setSearchQuery(e.target.value)}
        />
        {searchQuery && (
          <button 
            onClick={() => setSearchQuery('')}

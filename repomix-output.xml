          color: var(--text-muted);
          font-family: var(--font-sans);
          font-size: 12px;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          font-weight: 700;
          transition: color 0.2s;
        }
        .password-toggle:hover {
          color: var(--ink);
        }

        .reg-hint {
          font-family: var(--font-sans);
          font-size: 12px;
          color: var(--text-muted);
          margin-top: 10px;
          line-height: 1.4;
        }
        .reg-hint code {
          background: var(--bg-rose);
          color: var(--accent);
          padding: 2px 8px;
          border-radius: 4px;

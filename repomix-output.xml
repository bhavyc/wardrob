    await fetch('/api/auth/logout', { method: 'POST' });
    setSession(null);
    setMobileMenuOpen(false);
    router.refresh();
    router.push('/');
  };

  const handleSearch = (e: React.FormEvent) => {
    e.preventDefault();
    if (searchQuery.trim()) {

                <div className="kpi-num">{stats.intake}</div>
                <div className="kpi-lbl">Pending Intake</div>
              </div>
            </Link>

            <Link href="/hub/inspections" className="kpi-card dispatch">
              <div className="kpi-icon">🚚</div>
              <div>
                <div className="kpi-num">{stats.dispatch}</div>
